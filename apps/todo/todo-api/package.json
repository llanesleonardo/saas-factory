    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17"
  }
}
