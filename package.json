{
  "name": "saas-factory",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run mfg -- validate apps",
    "mfg": "npx tsx factory/factory_cli/mfg.ts",
    "pipeline": "npx tsx factory/factory_cli/mfg.ts pipeline run --",
    "pipeline:plan": "npx tsx factory/factory_cli/mfg.ts pipeline plan --",
    "purge": "npx tsx factory/factory_cli/mfg.ts app purge --",
    "purge:dry": "npx tsx factory/factory_cli/mfg.ts app purge -- --dry-run",
    "test:components": "node --import tsx --test factory/factory_libs/components/__tests__/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "boxen": "^8.0.1",
    "picocolors": "^1.1.1"
  },
  "workspaces": [
    "apps/*/*",
    "packages/*",
    "packages/components/*"
  ]
}
