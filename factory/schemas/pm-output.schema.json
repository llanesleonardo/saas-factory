{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saasfactory.local/schemas/pm-output.schema.json",
  "title": "PM agent structured output",
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "vertical_id": { "type": "string" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "title": { "type": "string", "minLength": 3 },
          "description": { "type": "string" },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "assigned_agent": {
            "type": "string",
            "description": "Suggested executor role id from factory/agent-registry.json"
          },
          "status": {
            "type": "string",
            "enum": ["backlog", "ready", "in_progress", "blocked", "done"]
          },
          "priority": { "type": "integer" },
          "app": { "type": "string" },
          "blocked_reason": { "type": "string" }
        }
      }
    }
  }
}
