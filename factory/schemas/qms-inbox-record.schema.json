{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saasfactory.local/schemas/qms-inbox-record.schema.json",
  "title": "QMS inbox companion record (optional)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date_utc", "agent_role", "task_id", "spec_pr_refs", "evidence_paths", "handoff_next_role"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "date_utc": {
      "type": "string",
      "description": "UTC calendar date for the record (YYYY-MM-DD).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "agent_role": {
      "type": "string",
      "description": "Factory agent role id (matches agent prompts and registry role ids).",
      "enum": [
        "pm",
        "dev",
        "quality",
        "fix",
        "git",
        "builder",
        "architect",
        "security",
        "devops",
        "docs",
        "support",
        "tooling",
        "finops",
        "spike",
        "spec-generator"
      ]
    },
    "task_id": {
      "type": "string",
      "description": "Task id from factory/task-queue.json or 'n/a'.",
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "description": "Optional task ids this work depends on.",
      "items": { "type": "string", "minLength": 1 }
    },
    "related_inbox_records": {
      "type": "array",
      "description": "Optional references to related QMS inbox markdown/records (filenames).",
      "items": { "type": "string", "minLength": 1 }
    },
    "spec_pr_refs": {
      "type": "array",
      "description": "Paths and/or PR refs relevant to this work (no secrets).",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_paths": {
      "type": "array",
      "description": "Paths to evidence artifacts (files, reports, fixtures) inside this repo.",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "handoff_next_role": {
      "type": "string",
      "description": "Suggested next role to continue the work.",
      "enum": [
        "pm",
        "dev",
        "quality",
        "fix",
        "git",
        "builder",
        "architect",
        "security",
        "devops",
        "docs",
        "support",
        "tooling",
        "finops",
        "spike",
        "spec-generator"
      ]
    }
  }
}
