{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saasfactory.local/schemas/agent-registry.schema.json",
  "title": "SaaS Factory agent-registry",
  "type": "object",
  "required": ["registry_version", "agents"],
  "properties": {
    "registry_version": { "type": "integer", "minimum": 1 },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["category", "file"],
        "properties": {
          "category": { "enum": ["execution", "advisory"] },
          "file": { "type": "string" },
          "allowed_inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "output_schema": { "type": "string" },
          "next_agents": { "type": "array", "items": { "type": "string" } },
          "context_pack": { "type": "string" },
          "approval_human_for": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
