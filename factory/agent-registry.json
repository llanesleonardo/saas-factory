{
  "registry_version": 1,
  "description": "Central capability + routing map for SaaS Factory agents. Invocation UX: Cursor commands agent-* or @agents/<file>.md",
  "task_queue_file": "factory/task-queue.json",
  "categories": {
    "execution": "May modify product/repo artifacts per role (code, infra YAML, specs when scoped).",
    "advisory": "Guidance, review, structured recommendations — minimize direct production edits unless explicitly in-role (e.g. Docs edits docs)."
  },
  "agents": {
    "pm": {
      "category": "execution",
      "file": "agents/pm-agent.md",
      "allowed_inputs": ["spec_markdown", "configs_vertical_json", "prioritized_scope_notes"],
      "outputs": ["task_queue_json", "structured_pm_payload"],
      "output_schema": "factory/schemas/pm-output.schema.json",
      "next_agents": ["architect", "dev", "builder"],
      "context_pack": "factory/context-packs/pm.json",
      "approval_human_for": ["scope_cut", "regulatory_commitments"]
    },
    "architect": {
      "category": "advisory",
      "file": "agents/architect-agent.md",
      "allowed_inputs": ["problem_statement", "multi_package_change", "spec_nonfunctional"],
      "outputs": ["boundary_recommendation", "optional_adr", "constraints_for_pm_dev"],
      "next_agents": ["pm", "dev", "security"],
      "context_pack": "factory/context-packs/architect.json"
    },
    "dev": {
      "category": "execution",
      "file": "agents/dev-agent.md",
      "allowed_inputs": ["task_id", "spec_sections", "branch_convention"],
      "outputs": ["code_changes", "dev_agent_report_json"],
      "output_schema": "factory/schemas/dev-output.schema.json",
      "next_agents": ["quality", "tooling"],
      "context_pack": "factory/context-packs/dev.json"
    },
    "quality": {
      "category": "execution",
      "file": "agents/quality-agent.md",
      "allowed_inputs": ["task_id", "codebase", "ci_logs", "harness_notes"],
      "outputs": ["quality_gate_json"],
      "output_schema": "factory/schemas/quality-output.schema.json",
      "next_agents": ["fix", "git"],
      "approval_human_for": ["waive_gate"],
      "context_pack": "factory/context-packs/quality.json"
    },
    "fix": {
      "category": "execution",
      "file": "agents/fix-agent.md",
      "allowed_inputs": ["quality_errors_json", "ci_failure_logs"],
      "outputs": ["minimal_patch", "fix_summary"],
      "next_agents": ["quality"],
      "context_pack": "factory/context-packs/fix.json"
    },
    "git": {
      "category": "execution",
      "file": "agents/git-agent.md",
      "allowed_inputs": ["validated_diff", "task_id", "ci_green_signal"],
      "outputs": ["branch_commits", "pr_markdown"],
      "next_agents": ["devops", "pm"],
      "context_pack": "factory/context-packs/git.json"
    },
    "devops": {
      "category": "execution",
      "file": "agents/devops-agent.md",
      "allowed_inputs": ["merged_change", "workflow_yaml", "incident_notes"],
      "outputs": ["runbook", "infra_diff"],
      "next_agents": ["quality", "security"],
      "context_pack": "factory/context-packs/devops.json"
    },
    "docs": {
      "category": "advisory",
      "file": "agents/docs-agent.md",
      "allowed_inputs": ["audience", "qms_inbox_records", "paths_to_document"],
      "outputs": ["markdown_docs", "published_qms_optional"],
      "next_agents": ["tooling", "pm"],
      "context_pack": "factory/context-packs/docs.json"
    },
    "security": {
      "category": "advisory",
      "file": "agents/security-agent.md",
      "allowed_inputs": ["feature_description", "diff_summary", "data_classification_hints"],
      "outputs": ["risk_register_style_review", "severity_ranked_findings"],
      "next_agents": ["pm", "dev", "devops"],
      "context_pack": "factory/context-packs/security.json"
    },
    "finops": {
      "category": "advisory",
      "file": "agents/finops-agent.md",
      "allowed_inputs": ["billing_spec", "stripe_shapes", "cost_telemetry_aggregates"],
      "outputs": ["plan_matrix", "economics_snapshot", "pm_tasks_hints"],
      "next_agents": ["pm", "architect", "devops"],
      "context_pack": "factory/context-packs/finops.json"
    },
    "support": {
      "category": "advisory",
      "file": "agents/support-agent.md",
      "allowed_inputs": ["tickets_redacted", "transcript_summary"],
      "outputs": ["triage_structured", "routing_recommendations"],
      "next_agents": ["pm", "quality", "docs", "security"],
      "context_pack": "factory/context-packs/support.json"
    },
    "tooling": {
      "category": "execution",
      "file": "agents/tooling-agent.md",
      "allowed_inputs": ["factory_friction_report", "generator_request"],
      "outputs": ["factory_scripts", "cursor_rules", "workflow_updates"],
      "next_agents": ["dev", "devops", "docs"],
      "context_pack": "factory/context-packs/tooling.json"
    },
    "spike": {
      "category": "advisory",
      "file": "agents/spike-agent.md",
      "allowed_inputs": ["hypothesis", "time_box", "constraints"],
      "outputs": ["decision_summary", "experiment_log", "architect_handoff"],
      "next_agents": ["architect", "pm"],
      "context_pack": "factory/context-packs/spike.json"
    },
    "spec-generator": {
      "category": "execution",
      "file": "agents/spec-generator-agent.md",
      "allowed_inputs": ["configs_vertical_json", "generated_prompt_md", "template_outline"],
      "outputs": ["vertical_spec_md"],
      "next_agents": ["pm", "security", "architect"],
      "context_pack": "factory/context-packs/spec-generator.json",
      "approval_human_for": ["billing_compliance_tenancy"]
    },
    "builder": {
      "category": "execution",
      "file": "agents/builder-agent.md",
      "allowed_inputs": ["vertical_id", "reference_instance", "architecture_constraints"],
      "outputs": ["scaffold_checklist", "minimal_repo_diff"],
      "next_agents": ["pm", "dev", "devops"],
      "context_pack": "factory/context-packs/builder.json"
    }
  },
  "quality_gate_loop": ["quality", "fix", "quality"],
  "references": {
    "router": "organizational_memory/AGENTS.md",
    "architecture": "organizational_memory/ARCHITECTURE.md",
    "workflow_machine": "factory/workflow-state-machine.json",
    "qms_record": "agents/agent-record-for-qms.md"
  }
}
