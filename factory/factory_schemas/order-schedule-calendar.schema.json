{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "order-schedule-calendar",
  "title": "Order schedule calendar (React-ready)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "calendarVersion", "orderId", "timeZone", "updatedAt", "events"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "calendarVersion": { "type": "integer", "minimum": 1 },
    "orderId": { "type": "string", "minLength": 1 },
    "workOrderId": { "type": "string" },
    "timeZone": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "appSlugs", "start", "end"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["manufacturing", "milestone", "block"] },
          "title": { "type": "string", "minLength": 1 },
          "appSlugs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "start": { "type": "string", "minLength": 1 },
          "end": { "type": ["string", "null"] },
          "allDay": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
