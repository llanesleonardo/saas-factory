{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saasfactory.local/schemas/task-queue.schema.json",
  "title": "Factory task queue",
  "description": "Schema for factory/task-queue.json. The file may be either an array of tasks or an object with a tasks[] property (both are supported by factory/task-graph.ts loadTaskQueue).",
  "oneOf": [
    { "$ref": "#/$defs/taskArray" },
    {
      "type": "object",
      "required": ["tasks"],
      "additionalProperties": false,
      "properties": {
        "tasks": { "$ref": "#/$defs/taskArray" }
      }
    }
  ],
  "$defs": {
    "taskArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "task": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "title": { "type": "string", "minLength": 3 },
        "description": { "type": "string" },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["backlog", "ready", "in_progress", "blocked", "done"] },
        "priority": { "type": "integer" },
        "phase": {
          "type": "string",
          "description": "Planning/reporting only. Convention: numeric strings (validated by tooling).",
          "pattern": "^[0-9]+$"
        },
        "blocked_reason": { "type": "string" },
        "owner": { "type": "string" },
        "app": { "type": "string" },
        "assigned_agent": { "type": "string", "description": "Suggested role id from factory/agent-registry.json" },
        "materials": {
          "type": "array",
          "description": "Inputs for the task (specs, IR paths, URLs). Non-empty strings when present.",
          "items": { "type": "string", "minLength": 1 }
        },
        "workcenters": {
          "type": "array",
          "description": "Stations / lanes (e.g. 03_assembly_lines station ids or agent roles).",
          "items": { "type": "string", "minLength": 1 }
        },
        "services": {
          "type": "array",
          "description": "Cross-cutting services (security, deploy, docs, …).",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "blocked" } },
            "required": ["status"]
          },
          "then": { "required": ["blocked_reason"] }
        }
      ]
    }
  }
}

