{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "verified-apps-registry",
  "title": "Verified manufacturing registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "apps"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "description": { "type": "string" },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "verifiedAt"],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "verifiedAt": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
