{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saas-factory.local/schemas/order-manifest.schema.json",
  "title": "Shop order manifest",
  "description": "Admits an order to the assembly line: `factory/01_production_planning/01_00_work_orders/<orderId>/order-manifest.json` → `configs/apps/<productId>/`. Validated by `mfg order validate`. Process: `factory/06_knowledge_base/go_to_market/SALES-AND-ASSEMBLY-LINE-GUIDE.md` — intake (diagram block 2), checklist **A**.",
  "allOf": [
    {
      "$ref": "#/$defs/manifestBase"
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["products"]
      },
      "then": {},
      "else": {
        "required": ["productId"]
      }
    }
  ],
  "$defs": {
    "manifestBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orderId"],
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Optional; editor hint. Repo-relative or absolute URI to this schema."
        },
        "orderId": {
          "type": "string",
          "minLength": 1,
          "description": "Folder name under `01_00_work_orders/`."
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "description": "Legacy single-product line when `products` is absent or empty."
        },
        "productVersion": {
          "type": "string"
        },
        "priority": {
          "type": "number",
          "minimum": 0
        },
        "products": {
          "type": "array",
          "description": "Multi-app order: when non-empty, each row is one product line (and legacy `productId` is ignored by tooling).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["productId"],
            "properties": {
              "productId": {
                "type": "string",
                "minLength": 1
              },
              "productVersion": {
                "type": "string"
              },
              "priority": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "planRef": {
          "type": "string",
          "description": "Optional folder under `factory/01_production_planning/plans/<planRef>/`."
        },
        "notes": {
          "type": "string"
        },
        "lifecycleStatus": {
          "type": "string",
          "enum": [
            "intake",
            "quoted",
            "confirmed",
            "scheduled",
            "phases_defined",
            "executing",
            "completed",
            "cancelled"
          ],
          "description": "Factory-side lifecycle; commercial status stays in `sales-order.json`."
        },
        "lastLifecycleEventAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
